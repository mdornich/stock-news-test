# Stock Explainer API Keys
# Copy this file to .env and add your actual API keys
# Note: Not all keys are required - the tool will skip sources without keys

# ============================================================================
# REQUIRED API KEYS
# ============================================================================

# Anthropic API Key (REQUIRED for AI analysis)
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ============================================================================
# NEWS SOURCE API KEYS (All Optional - more sources = better analysis)
# ============================================================================

# NewsAPI (Free tier: 100 requests/day)
# Get yours at: https://newsapi.org/
NEWSAPI_KEY=your_newsapi_key_here

# Finnhub (Free tier: 60 calls/min, very timely data)
# Get yours at: https://finnhub.io/register
FINNHUB_API_KEY=your_finnhub_key_here

# Alpha Vantage (Free tier: 5 calls/min, includes sentiment)
# Get yours at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# ============================================================================
# SOCIAL MEDIA API KEYS (Optional)
# ============================================================================

# Reddit API (Free - detects retail sentiment)
# Get yours at: https://www.reddit.com/prefs/apps
# Create an app, select "script", and use the credentials below
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=StockExplainerBot/1.0 by YourUsername

# StockTwits (Optional - no key needed for basic access, but can add if available)
STOCKTWITS_API_KEY=your_stocktwits_key_here

# Twitter/X Bearer Token (Optional - paid API only)
# Only needed if you have Twitter API access
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# ============================================================================
# NOTES ON DATA SOURCES
# ============================================================================
# - Google News: No API key needed (uses RSS feeds)
# - SEC EDGAR: No API key needed (public API)
# - Yahoo Finance: No API key needed (via yfinance library)
# - The more API keys you provide, the better the catalyst detection!
